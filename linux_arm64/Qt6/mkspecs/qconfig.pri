QT_ARCH = arm64
QT_BUILDABI = 
QT_LIBCPP_ABI_TAG = 
QT.global.enabled_features = version_tagging shared pkg-config rpath signaling_nan thread future concurrent dbus test_gui test_squish shared glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker shared rpath reduce_exports
QT.global.disabled_features = static cross_compile debug_and_release separate_debug_info appstore-compliant simulator_and_device force_asserts framework c++20 c++2a c++2b c++2c reduce_relocations wasm-simd128 wasm-exceptions wasm-jspi zstd openssl-linked opensslv11 opensslv30
QT.global.disabled_features += release build_all
QT_CONFIG += shared rpath reduce_exports release
CONFIG += release  shared plugin_manifest glibc_fortify_source stack_protector stack_clash_protection libstdcpp_assertions relro_now_linker
QT_VERSION = 6.11.1
QT_MAJOR_VERSION = 6
QT_MINOR_VERSION = 11
QT_PATCH_VERSION = 1

QT_GCC_MAJOR_VERSION = 11
QT_GCC_MINOR_VERSION = 4
QT_GCC_PATCH_VERSION = 0
