prefix=/usr/local/Qt-6.11.1
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick
Description: Qt Quick module
Version: 6.11.1
Libs: -L${libdir} -lQt6Quick
Cflags: -I${includedir}/QtQuick -I${includedir} -DQT_QUICK_LIB
Requires: Qt6OpenGL Qt6Core Qt6Gui Qt6Qml
