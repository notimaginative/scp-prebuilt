prefix=/usr/local/Qt-6.11.1
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Xml
Description: Qt Xml module
Version: 6.11.1
Libs: -L${libdir} -lQt6Xml
Cflags: -I${includedir}/QtXml -I${includedir} -DQT_XML_LIB
Requires: Qt6Core
