prefix=/usr/local/Qt-6.11.1
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 RemoteObjectsQml
Description: Qt RemoteObjectsQml module
Version: 6.11.1
Libs: -L${libdir} -lQt6RemoteObjectsQml
Cflags: -I${includedir}/QtRemoteObjectsQml -I${includedir} -DQT_REMOTEOBJECTSQML_LIB
