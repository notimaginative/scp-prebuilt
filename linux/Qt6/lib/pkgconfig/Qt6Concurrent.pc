prefix=/usr/local/Qt-6.11.1
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Concurrent
Description: Qt Concurrent module
Version: 6.11.1
Libs: -L${libdir} -lQt6Concurrent
Cflags: -I${includedir}/QtConcurrent -I${includedir} -DQT_CONCURRENT_LIB
Requires: Qt6Core
