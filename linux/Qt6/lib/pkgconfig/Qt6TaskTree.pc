prefix=/usr/local/Qt-6.11.1
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 TaskTree
Description: Qt TaskTree module
Version: 6.11.1
Libs: -L${libdir} -lQt6TaskTree
Cflags: -I${includedir}/QtTaskTree -I${includedir} -DQT_TASKTREE_LIB
Requires: Qt6Core Qt6Concurrent Qt6Network
