prefix=/usr/local/Qt-6.11.1
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Sql
Description: Qt Sql module
Version: 6.11.1
Libs: -L${libdir} -lQt6Sql
Cflags: -I${includedir}/QtSql -I${includedir} -DQT_SQL_LIB
Requires: Qt6Core
